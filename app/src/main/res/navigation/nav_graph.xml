<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/authFragment"
        android:name="com.tether.app.ui.auth.AuthFragment"
        android:label="Auth"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_auth_to_groupList"
            app:destination="@id/groupListFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/groupListFragment"
        android:name="com.tether.app.ui.home.GroupListFragment"
        android:label="Home"
        tools:layout="@layout/fragment_group_list">
        <action
            android:id="@+id/action_groupList_to_feed"
            app:destination="@id/groupFeedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_groupList_to_leaderboard"
            app:destination="@id/leaderboardFragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_groupList_to_profile"
            app:destination="@id/profileFragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_groupList_to_group"
            app:destination="@id/groupFragment"
            app:launchSingleTop="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/groupFeedFragment"
        android:name="com.tether.app.ui.home.GroupFeedFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_group_feed">
        <action
            android:id="@+id/action_feed_to_track"
            app:destination="@id/trackFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>


    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.tether.app.ui.leaderboard.LeaderboardFragment"
        android:label="Leaderboard"
        app:popUpTo="@id/groupListFragment"
        app:popUpToInclusive="false"
        tools:layout="@layout/fragment_leaderboard">
        <action
            android:id="@+id/action_leaderboard_to_home"
            app:destination="@id/groupListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_leaderboard_to_profile"
            app:destination="@id/profileFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.tether.app.ui.profile.ProfileFragment"
        android:label="Profile"
        app:popUpTo="@id/groupListFragment"
        app:popUpToInclusive="false"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_home"
            app:destination="@id/groupListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profile_to_leaderboard"
            app:destination="@id/leaderboardFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_profile_to_group"
            app:destination="@id/groupFragment" />
        <action
            android:id="@+id/action_profile_to_about"
            app:destination="@id/aboutFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_profile_to_track"
            app:destination="@id/trackFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_profile_to_faq"
            app:destination="@id/faqFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.tether.app.ui.profile.AboutFragment"
        android:label="About"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/faqFragment"
        android:name="com.tether.app.ui.profile.FaqFragment"
        android:label="FAQ"
        tools:layout="@layout/fragment_faq" />

    <fragment
        android:id="@+id/trackFragment"
        android:name="com.tether.app.ui.tracks.TrackFragment"
        android:label="Track"
        tools:layout="@layout/fragment_track">
        <argument
            android:name="trackId"
            app:argType="string" />
        <argument
            android:name="groupId"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/groupFragment"
        android:name="com.tether.app.ui.group.GroupFragment"
        android:label="Groups"
        tools:layout="@layout/fragment_group">
    </fragment>


</navigation>

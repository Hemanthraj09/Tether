<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/authFragment"
        android:name="com.tether.app.ui.auth.AuthFragment"
        android:label="Auth"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_auth_to_groupList"
            app:destination="@id/groupListFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/groupListFragment"
        android:name="com.tether.app.ui.home.GroupListFragment"
        android:label="Home"
        tools:layout="@layout/fragment_group_list">
        <action
            android:id="@+id/action_groupList_to_feed"
            app:destination="@id/groupFeedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_groupList_to_leaderboard"
            app:destination="@id/leaderboardFragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_groupList_to_profile"
            app:destination="@id/profileFragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_groupList_to_group"
            app:destination="@id/groupFragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/groupFeedFragment"
        android:name="com.tether.app.ui.home.GroupFeedFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_group_feed" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tether.app.ui.home.HomeFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_leaderboard"
            app:destination="@id/leaderboardFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_home_to_group"
            app:destination="@id/groupFragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.tether.app.ui.leaderboard.LeaderboardFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_leaderboard">
        <action
            android:id="@+id/action_leaderboard_to_home"
            app:destination="@id/groupListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_leaderboard_to_profile"
            app:destination="@id/profileFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.tether.app.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_home"
            app:destination="@id/groupListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profile_to_leaderboard"
            app:destination="@id/leaderboardFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/groupListFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_profile_to_group"
            app:destination="@id/groupFragment" />
    </fragment>

    <fragment
        android:id="@+id/groupFragment"
        android:name="com.tether.app.ui.group.GroupFragment"
        android:label="Groups"
        tools:layout="@layout/fragment_group">
    </fragment>

    <dialog
        android:id="@+id/logBottomSheetFragment"
        android:name="com.tether.app.ui.log.LogBottomSheetFragment"
        android:label="Log Progress"
        tools:layout="@layout/layout_log_bottom_sheet" />

</navigation>

<?xml version="1.0" encoding="utf-8"?>
<!-- Running session: phase, live time, breaks (stopwatch) and Stop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:id="@+id/tvPhaseLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_icon_container_accent"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:text="Focusing"
        android:textColor="@color/colorAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTimerDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-light"
        android:text="00:00"
        android:textColor="@color/colorTextPrimary"
        android:textSize="64sp" />

    <LinearLayout
        android:id="@+id/layoutBreakOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <android.widget.Button
            android:id="@+id/btnBreak5"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null"
            android:text="5 min break"
            android:textAllCaps="false"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp" />

        <android.widget.Button
            android:id="@+id/btnBreak10"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null"
            android:text="10 min break"
            android:textAllCaps="false"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp" />
    </LinearLayout>

    <android.widget.Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_danger"
        android:stateListAnimator="@null"
        android:text="Stop session"
        android:textAllCaps="false"
        android:textColor="@color/colorTextPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>

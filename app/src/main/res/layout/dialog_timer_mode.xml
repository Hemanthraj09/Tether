<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How do you want to work today?"
            android:textColor="@color/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/layoutModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnNormal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Normal"
                android:backgroundTint="@color/elevated"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPomodoro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Pomodoro"
                android:backgroundTint="@color/elevated"
                android:textColor="@color/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPomoConfigs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPomo25"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="25/5"
                android:backgroundTint="@color/elevated"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPomo50"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="50/10"
                android:backgroundTint="@color/elevated"
                android:textColor="@color/colorTextPrimary" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- One member's progress in a group track race -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvRaceInitials"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:textColor="@color/colorTextPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="AR" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRaceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                tools:text="Asha Rao" />

            <TextView
                android:id="@+id/tvRaceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                tools:text="42 / 150" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressRace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="1000"
            app:indicatorColor="@color/colorAccent"
            app:trackColor="@color/colorElevated"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/tvRaceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="205 solved on LeetCode"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            tools:text="Longest Substring Without Repeating Characters" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_difficulty_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                tools:text="Medium" />

            <TextView
                android:id="@+id/tvItemSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp"
                tools:text="LeetCode" />

            <!-- Up to 6 members who completed it (race mode) -->
            <LinearLayout
                android:id="@+id/layoutSolvers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/solver1" style="@style/SolverDot" />
                <TextView android:id="@+id/solver2" style="@style/SolverDot" />
                <TextView android:id="@+id/solver3" style="@style/SolverDot" />
                <TextView android:id="@+id/solver4" style="@style/SolverDot" />
                <TextView android:id="@+id/solver5" style="@style/SolverDot" />
                <TextView android:id="@+id/solver6" style="@style/SolverDot" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tap to tick / untick manually. Verified items show a green check. -->
    <FrameLayout
        android:id="@+id/btnItemStatus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mark as done">

        <ImageView
            android:id="@+id/ivItemStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_status_none"
            android:padding="4dp"
            android:src="@drawable/ic_check" />
    </FrameLayout>
</LinearLayout>
